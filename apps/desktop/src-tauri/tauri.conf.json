{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "graphicgene",
  "identifier": "io.github.ragnarokmin0714.graphicgene",
  "build": {
    "beforeDevCommand": "pnpm -w dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm -w build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "graphicgene",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "GraphicsAndDesign",
    "shortDescription": "A vector graphics editor",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
