{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    // TypeScript 7 removed `baseUrl`; `paths` now resolves relative to this
    // file, which is what we wanted anyway.
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
